NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/fluento
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
# OpenAI (required for transcription + evaluation)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_EVAL_MODEL=gpt-4o-mini
# Private audio storage (shared between API and worker)
STORAGE_DIR=./private-storage
MAX_AUDIO_MB=25
# SMTP for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fluento <no-reply@fluento.app>
APP_URL=http://localhost:5173
